{
  "name": "six-cities",
  "version": "4.0.0",
  "description": "Проект «Шесть городов» от HTML Academy",
  "keywords": [
    "rest",
    "api",
    "node.js"
  ],
  "main": "main.rest.js",
  "scripts": {
    "start": "npm run build && node ./dist/main.rest.js",
    "start:dev": "tsx ./src/main.rest.ts | pino-pretty --colorize --translateTime SYS:standard",
    "build": "npm run clean && npm run compile",
    "lint": "eslint src/ --ext .ts",
    "compile": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "ts": "ts-node",
    "cli": "tsx ./src/main.cli.ts",
    "mock:server": "json-server --watch ./mocks/mock-server-data.json --port 3123"
  },
  "devDependencies": {
    "@types/convict": "^6.1.6",
    "@types/convict-format-with-validator": "^6.0.6",
    "@types/node": "18.19.130",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "eslint": "8.39.0",
    "eslint-config-htmlacademy": "9.1.1",
    "json-server": "^0.17.4",
    "pino-pretty": "^13.2.0",
    "rimraf": "3.0.2",
    "ts-node": "10.9.1",
    "tsx": "4.23.15",
    "typescript": "5.4.5"
  },
  "type": "module",
  "engines": {
    "node": "^18.0.0",
    "npm": ">=8"
  },
  "dependencies": {
    "@typegoose/typegoose": "12.21.1",
    "chalk": "5.6.2",
    "convict": "^6.2.5",
    "convict-format-with-validator": "^6.2.0",
    "dotenv": "^18.0.8",
    "inversify": "^6.2.2",
    "mongoose": "8.21.1",
    "pino": "^8.21.0",
    "reflect-metadata": "^0.2.2"
  }
}
